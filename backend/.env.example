PROJECT_NAME="MetaRouter AI Gateway"
# DATABASE_URL="postgresql://postgres:postgres@db:5432/metarouter_db"
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/metarouter_db
REDIS_URL="redis://localhost:6379/0"    # docker ="redis://db:6379/0"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
META_API_VERSION="v20.0"
META_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15

# Token lifetimes (logout and refresh rotation revoke tokens through the Redis blacklist)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_ROTATION_GRACE_SECONDS=30
SUPER_ADMIN_TOKEN_EXPIRE_MINUTES=1440
# Read-only support session ("Log in as user" from super admin) and its one-time hand-off code
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30
IMPERSONATION_CODE_EXPIRE_SECONDS=60
# Refresh-token cookie only over HTTPS - set to true in production
COOKIE_SECURE=false
# Login protection: failed attempts per email + IP / per IP, then locked for the lockout minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15

FRONTEND_BASE_URL=http://localhost:5173
# Where a workspace opens; {slug} is replaced (production: https://{slug}.metarouter.ai)
WORKSPACE_URL_TEMPLATE=http://localhost:5173

GOOGLE_API_KEY=

# CORS Origins (comma-separated list for local dev and Docker/production)
CORS_ORIGINS="http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173"


# Super Admin Bootstrap Credentials
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@example.com

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

ngrok =3KXsrwyYSLrxWpUihdGBYZpcX7T_7TA6BhepjFVSGSA9DDgbB

# ngrok http --url=https://ninth-taco-snuff.ngrok-free.dev 8000

# Meta app secret (App settings > Basic) - verifies webhook signatures
META_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=
# Paste this same value into the Meta app's WhatsApp webhook 'Verify token' field
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Encrypts stored WhatsApp access tokens - never change or lose it once tokens are saved
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Customer media downloaded from WhatsApp (Docker volume media_data)
MEDIA_STORAGE_PATH=/data/media
MEDIA_MAX_DOWNLOAD_BYTES=26214400
MEDIA_MAX_PARSE_BYTES=15728640
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_PARSER_MODEL=gemini-3.8-flash
GEMINI_CHAT_BACKUP_MODEL=gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_PARSER_BACKUP_MODEL=gemini-flash-latest,gemini-3.6-flash
GEMINI_AUDIO_MODEL=gemini-3.5-flash
GEMINI_AUDIO_BACKUP_MODEL=gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRIES=1
GEMINI_CHAT_TIMEOUT_SECONDS=20
# "Try it" AI simulator: test questions per admin every 10 minutes (each is a Gemini call)
AI_SIMULATOR_MAX_PER_10_MIN=30

# Knowledge base PDFs (AI Assistant page)
KNOWLEDGE_STORAGE_PATH=/data/media/knowledge
KNOWLEDGE_MAX_PDF_BYTES=10485760
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_MAX_DOCUMENTS=50

# Broadcasts
BROADCAST_MESSAGES_PER_SECOND=20
BROADCAST_DISPATCH_BATCH_SIZE=500
BROADCAST_RECENT_MESSAGE_DAYS=7
BROADCAST_MAX_RECIPIENTS=10000
BROADCAST_MAX_CSV_BYTES=2097152
BROADCAST_DEFAULT_NAME=Customer
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
OPT_IN_KEYWORDS=START

# Scheduled jobs (Celery Beat)
NUMBER_REFRESH_INTERVAL_MINUTES=360
MESSAGE_SWEEP_INTERVAL_MINUTES=5
STUCK_MESSAGE_MINUTES=10
STUCK_MEDIA_MAX_AGE_HOURS=24
BROADCAST_CHECK_INTERVAL_SECONDS=60
TICKET_IDLE_CLOSE_HOURS=4
TICKET_SWEEP_INTERVAL_MINUTES=10
VISIT_GAP_HOURS=4
UNASSIGNED_REMINDER_MINUTES=5,15
UNASSIGNED_REMINDER_CHECK_SECONDS=60
NOTIFICATION_RETENTION_DAYS=60
NOTIFICATION_CLEANUP_INTERVAL_HOURS=24
STALLED_BROADCAST_MINUTES=10
