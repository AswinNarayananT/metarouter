# Docker Compose values (read by docker-compose.yml)
# Database - change the password for any shared or production setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metarouter_db

# API and WebSocket URLs baked into the frontend build (wss:// behind HTTPS)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
